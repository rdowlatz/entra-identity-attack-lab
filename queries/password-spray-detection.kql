// =============================================================
// Password Spray Detection
// -------------------------------------------------------------
// Flags any source IP that failed credential checks (50126)
// against 5 or more DISTINCT accounts in the time window.
//
// Signal: one IP, one password, many accounts, short window.
// MITRE ATT&CK: T1110.003 - Brute Force: Password Spraying
// =============================================================

SigninLogs
| where TimeGenerated > ago(1h)
| where ResultType == "50126"                       // invalid username or password
| summarize
    FailedAttempts   = count(),
    TargetedAccounts = dcount(UserPrincipalName),    // distinct victims = the "many accounts" signal
    Users            = make_set(UserPrincipalName),  // the actual victim list
    FirstSeen        = min(TimeGenerated),
    LastSeen         = max(TimeGenerated)
    by IPAddress
| where TargetedAccounts >= 5                        // detection threshold (tune to environment size)
| sort by FailedAttempts desc
